# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: URL of your Supabase project (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Safe public anon key for your Supabase project
SUPABASE_ANON_KEY=your-supabase-anon-key

# RECAPTCHA_SITE_KEY: reCAPTCHA Enterprise key for Firebase App Check production attestation
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

